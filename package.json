{
  "name": "fivehour",
  "version": "0.1.0",
  "private": true,
  "description": "Menu bar / system tray timer for your Claude 5-hour usage limit: % used, reset countdown, weekly limit and notifications. Unofficial.",
  "keywords": [
    "claude",
    "claude-code",
    "usage",
    "rate-limit",
    "menu-bar",
    "tray",
    "electron"
  ],
  "homepage": "https://github.com/Luchitha7/fivehour#readme",
  "bugs": {
    "url": "https://github.com/Luchitha7/fivehour/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luchitha7/fivehour.git"
  },
  "author": "Luchitha Jayawardena (https://github.com/Luchitha7)",
  "license": "MIT",
  "main": "src/main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "check": "node --check src/main.js && npm test",
    "dist": "electron-builder --publish never",
    "icon": "node scripts/make-icon.js"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.luchitha7.fivehour",
    "productName": "fivehour",
    "copyright": "Copyright \u00a9 2026 Luchitha Jayawardena",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "publish": null,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "fivehour-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "fivehour ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "fivehour-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "fivehour-${version}-linux-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron@45.2.2": true
  }
}
